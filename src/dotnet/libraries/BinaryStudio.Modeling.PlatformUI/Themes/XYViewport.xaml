<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:e="clr-namespace:BinaryStudio.Modeling.PlatformUI.Controls">
  <Style TargetType="{x:Type e:XYViewport}">
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Margin" Value="10"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type e:XYViewport}">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
            <ScrollViewer Background="Transparent" CanContentScroll="True" Name="ScrollViewer"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          AllowDrop="False">
              <Grid>
                <e:XYViewportSurface Offset="{Binding ElementName=ItemsHost,Path=Offset,Mode=OneWay}" x:Name="ViewportSurface"/>
                <e:XYViewportPanel x:Name="ItemsHost" IsItemsHost="True">
                  <e:XYViewportPanel.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding RelativeSource={RelativeSource TemplatedParent},Path=Scale,Mode=OneWay}"
                                    ScaleY="{Binding RelativeSource={RelativeSource TemplatedParent},Path=Scale,Mode=OneWay}"/>
                  </e:XYViewportPanel.LayoutTransform>
                </e:XYViewportPanel>
              </Grid>
            </ScrollViewer>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="{x:Type e:XYViewportShape}">
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Background"  Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type e:XYViewportShape}">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
            <ContentPresenter Content="{TemplateBinding Content}"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style></ResourceDictionary>