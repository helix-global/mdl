              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_R8MyJhCoEfCxXpi0wJwkWw"/>
            </ownedParameter>
            <ownedParameter xmi:type="uml:Parameter" xmi:id="_R8MyJxCoEfCxXpi0wJwkWw" name="pPrev" type="_R9CfmBCoEfCxXpi0wJwkWw" direction="inout">
